# Cloudflare Pages headers for the new site.
# Caching rules use "! Cache-Control" to detach the default before setting a path-specific value,
# so the result never depends on how overlapping rules merge.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output (filenames change on every content change)
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images: never overwrite in place; use a new filename (e.g. ogp-v3.png)
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Service worker kill switch must always be revalidated
/sw.js
  Service-Worker-Allowed: /

# CMS admin: not indexed, strict CSP (all scripts and styles are same-origin)
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
