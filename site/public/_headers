# Cloudflare Pages headers for the new site.
# Caching rules use "! Cache-Control" to detach the default before setting a path-specific value,
# so the result never depends on how overlapping rules merge.

/*
  Strict-Transport-Security: max-age=86400; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output (filenames change on every content change)
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images: never overwrite in place; use a new filename (e.g. ogp-v3.png)
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Design lab (noindex review pages): framable by the site itself, so the Media sample on
# /lab/components/ can show /lab/d/ in its iframe. Every other page stays DENY.
/lab/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN

# Service worker kill switch must always be revalidated
/sw.js
  Service-Worker-Allowed: /

# CMS admin: not indexed, strict CSP. Scripts are same-origin only. Styles also allow inline,
# because the body editor (CodeMirror) injects its stylesheet in a <style> element at runtime.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
