---
// The hero's picture: a part printed one layer at a time. Sits inside the hero panel (see Home.astro).
// The static drawing below is the content-equivalent fallback; the WebGL scene replaces it once it runs.
import { contour } from '../components/toolpath';

const layers = 24;
---

<div class="top-scene" data-top-scene aria-hidden="true">
  <canvas class="top-scene__canvas"></canvas>
  <!-- Shown until the scene runs, and permanently under reduced motion or without WebGL -->
  <svg class="top-scene__fallback" viewBox="0 0 600 420" focusable="false">
    {Array.from({ length: layers }, (_, i) => (
      <path d={contour(i, 300, 360, 12, 190)} class={i >= layers - 3 ? 'new' : undefined} style={`opacity:${(0.2 + (i / layers) * 0.8).toFixed(3)}`} />
    ))}
    <line x1="560" y1="84" x2="560" y2="360" class="dim"></line>
    <line x1="552" y1="84" x2="568" y2="84" class="dim"></line>
    <line x1="552" y1="360" x2="568" y2="360" class="dim"></line>
    <text x="548" y="226" text-anchor="end">{layers} × 0.20</text>
  </svg>
</div>

<script>
  import { boot } from './boot';
  boot();
</script>

<style>
  .top-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 7;
  }

  .top-scene__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .top-scene__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s var(--ease);
  }

  .top-scene__fallback path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  .top-scene__fallback path.new {
    stroke: var(--pen);
    stroke-width: 1.6;
  }

  .top-scene__fallback .dim {
    stroke: var(--pen);
    stroke-width: 1;
  }

  .top-scene__fallback text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--pen);
  }

  .top-scene:global(.is-live) .top-scene__canvas {
    opacity: 1;
  }

  .top-scene:global(.is-live) .top-scene__fallback {
    opacity: 0;
  }
</style>
