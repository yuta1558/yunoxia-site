---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// Zen Kaku Gothic New: only the subsets the site uses (scripts/font-subsets.mjs)
import '../styles/fonts.generated.css';
import '../styles/global.css';
import Bead from '../bead/Bead.astro';
import { counterpart, langOf, localPath, ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Leave out canonical and og:url (pages with no URL of their own, such as 404) */
  noCanonical?: boolean;
  ogType?: 'website' | 'article';
}

const lang = langOf(Astro.url.pathname);
const t = ui[lang];

const { title, description = t.defaultDescription, noindex = false, noCanonical = false, ogType = 'website' } = Astro.props;

const siteName = 'yunoxia';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t.siteTagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/ogp-v3.png', Astro.site);

// hreflang alternates only where the page exists in both languages
const other = counterpart(Astro.url.pathname);
const jaPath = lang === 'ja' ? Astro.url.pathname : other;
const enPath = lang === 'en' ? Astro.url.pathname : other;
const alternates = other
  ? [
      { hreflang: 'ja', href: new URL(jaPath!, Astro.site) },
      { hreflang: 'en', href: new URL(enPath!, Astro.site) },
      { hreflang: 'x-default', href: new URL(jaPath!, Astro.site) },
    ]
  : [];

const nav = [
  { href: localPath(lang, '/works/'), label: 'Works' },
  { href: localPath(lang, '/research/'), label: 'Research' },
  { href: '/log/', label: t.logLabel, hreflang: lang === 'en' ? 'ja' : undefined },
  { href: localPath(lang, '/about/'), label: 'About' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="yunoxia Log" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    {other && <meta property="og:locale:alternate" content={ui[lang === 'ja' ? 'en' : 'ja'].ogLocale} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#efece5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1430" media="(prefers-color-scheme: dark)" />

    <!-- Apply the theme before first paint (stored choice, then system preference) -->
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={localPath(lang, '/')} aria-label={t.home}>yunoxia</a>
      <nav aria-label={t.nav}>
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                hreflang={item.hreflang}
                aria-current={current.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {other && (
        <a class="lang" href={other} hreflang={lang === 'ja' ? 'en' : 'ja'} lang={lang === 'ja' ? 'en' : 'ja'}>
          {t.langSwitch}<span class="sr-only"> — {t.langSwitchLabel}</span>
        </a>
      )}
      <button class="theme" type="button" aria-label={t.theme} data-theme-toggle>
        <span aria-hidden="true"></span>
      </button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="meta">
        <a href="mailto:contact@yunoxia.one">contact@yunoxia.one</a>
        <span aria-hidden="true"> · </span>
        <a href="/rss.xml">RSS</a>
      </p>
      <p class="meta">© {new Date().getFullYear()} yunoxia</p>
    </footer>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-theme-toggle]');
        if (!toggle) return;
        // aria-pressed = the dark theme is on
        const sync = () => toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
        sync();
        toggle.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          sync();
        });
      })();
    </script>
    <Bead />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    z-index: 10;
  }

  .skip:focus {
    top: 0.5rem;
  }

  /* 52px bar with one hairline; the current page is underlined at the bar's lower edge */
  .site-header {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--bar-height);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  /* Wordmark: Geist 800, cut into layer lines like a sliced part */
  .brand {
    align-self: center;
    margin-right: auto;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    text-decoration: none;
    -webkit-mask-image: repeating-linear-gradient(to bottom, #000 0 0.1034em, transparent 0.1034em 0.1422em);
    mask-image: repeating-linear-gradient(to bottom, #000 0 0.1034em, transparent 0.1034em 0.1422em);
  }

  .brand:hover {
    color: var(--ink);
  }

  nav {
    display: flex;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav li {
    display: flex;
  }

  nav a {
    display: flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem;
    letter-spacing: -0.03em;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    margin-bottom: -1px;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  .lang {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    min-width: 2.75rem;
    text-align: center;
  }

  .lang:hover {
    color: var(--ink);
  }

  .theme {
    align-self: center;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    margin-right: -0.75rem;
  }

  /* Half-filled square: paper / blueprint */
  .theme span {
    width: 0.85rem;
    height: 0.85rem;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform var(--dur-base) var(--ease);
  }

  :global([data-theme='dark']) .theme span {
    transform: rotate(180deg);
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: var(--section-y);
    padding: 1.25rem var(--gutter);
    border-top: 1px solid var(--line);
  }

  /* Phones: the nav drops to its own row under the wordmark, keeping the bottom-edge underline */
  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      column-gap: 1rem;
    }

    .brand {
      padding-block: 0.9rem;
    }

    nav {
      order: 3;
      width: 100%;
      height: 2.75rem;
    }

    nav ul {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
