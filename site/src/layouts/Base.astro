---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// Zen Kaku Gothic New: only the subsets the site uses (scripts/font-subsets.mjs)
import '../styles/fonts.generated.css';
import '../styles/global.css';
import Bead from '../bead/Bead.astro';
import { LANGS, langOf, localPath, ui, versionLabel, versionsOf, type Lang } from '../i18n/ui';
import { koFont } from '../styles/fonts.generated.json';
import { jsonLdString, webSite } from '../lib/jsonld.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Leave out canonical and og:url (pages with no URL of their own, such as 404) */
  noCanonical?: boolean;
  ogType?: 'website' | 'article';
  /**
   * Structured data rendered as <script type="application/ld+json"> (one object or an array),
   * e.g. blogPosting() from src/lib/jsonld.mjs on Log posts. The top pages (/ and /en/) get a
   * WebSite object automatically. Never include a Person, author or any name.
   */
  jsonLd?: object | object[];
  /** Versioned path of the full font for CMS posts; /log/ passes it, the post Function turns it into a stylesheet link */
  cmsFont?: string;
}

const lang = langOf(Astro.url.pathname);
const t = ui[lang];

const {
  title,
  description = t.defaultDescription,
  noindex = false,
  noCanonical = false,
  ogType = 'website',
  jsonLd,
  cmsFont,
} = Astro.props;

const siteName = 'yunoxia';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t.siteTagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/ogp-v3.png', Astro.site);

// The page in its other languages: hreflang alternates, og:locale, the header link and the footer switch
const versions = versionsOf(Astro.url.pathname);
const others = LANGS.filter((l) => l !== lang && versions[l]);
const alternates = others.length
  ? [
      ...LANGS.filter((l) => versions[l]).map((l) => ({ hreflang: l, href: new URL(versions[l]!, Astro.site) })),
      ...(versions.ja ? [{ hreflang: 'x-default', href: new URL(versions.ja, Astro.site) }] : []),
    ]
  : [];
// The header keeps one link: English from Japanese, Japanese from the others
const headerLang: Lang | undefined = lang === 'ja' ? (versions.en ? 'en' : versions.ko ? 'ko' : undefined) : versions.ja ? 'ja' : undefined;

const nav = [
  // Korean has no Works list, Research or About of its own: those links lead to the Japanese pages
  { href: localPath(lang, '/works/'), label: 'Works', hreflang: lang === 'ko' ? 'ja' : undefined },
  { href: localPath(lang, '/research/'), label: 'Research', hreflang: lang === 'ko' ? 'ja' : undefined },
  { href: '/log/', label: t.logLabel, hreflang: lang !== 'ja' ? 'ja' : undefined },
  { href: localPath(lang, '/about/'), label: 'About', hreflang: lang === 'ko' ? 'ja' : undefined },
];
const current = Astro.url.pathname;
// Footer: the build date as the sheet's revision (JST)
const rev = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' })
  .format(new Date())
  .replaceAll('-', '.');
const year = rev.slice(0, 4);

// JSON-LD: WebSite on the top pages, plus whatever the page passes
const isTop = current === '/' || current === '/en/' || current === '/en';
const structured = [
  ...(isTop ? [webSite({ url: new URL(localPath(lang, '/'), Astro.site), lang, description })] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="yunoxia Log" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    {others.map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
    {lang === 'ko' && koFont && <link rel="stylesheet" href={koFont} />}
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((data) => <script type="application/ld+json" set:html={jsonLdString(data)} />)}

    <meta name="theme-color" content="#efece5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1430" media="(prefers-color-scheme: dark)" />

    <!-- Apply the theme before first paint. A stored 'light' / 'dark' wins; nothing stored is AUTO
         (the system preference). html[data-theme] always holds the resolved theme: the scene and the
         bead watch that attribute. -->
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {cmsFont && <template data-cms-font={cmsFont}></template>}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={localPath(lang, '/')} aria-label={t.home}>yunoxia</a>
      <nav aria-label={t.nav}>
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                hreflang={item.hreflang}
                aria-current={current.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {headerLang && (
        <a class="lang" href={versions[headerLang]} hreflang={headerLang} lang={headerLang}>
          {headerLang.toUpperCase()}<span class="sr-only"> — {versionLabel[headerLang]}</span>
        </a>
      )}
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot-mark">
        <a class="brand" href={localPath(lang, '/')} aria-label={t.home}>yunoxia</a>
        <p class="foot-line">{t.siteTagline}</p>
      </div>
      <nav class="foot-nav" aria-label={t.footerNav}>
        {nav.map((item) => (
          <a href={item.href} hreflang={item.hreflang}>{item.label}</a>
        ))}
      </nav>
      <div class="foot-links">
        {/* Keep Cloudflare Email Obfuscation off this link; set:html writes the comments out verbatim */}
        <Fragment set:html="<!--email_off-->" /><a href="mailto:contact@yunoxia.one">{t.contact}</a><Fragment set:html="<!--/email_off-->" />
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="foot-controls">
        {others.length > 0 && (
          <div class="seg" role="group" aria-label={t.language}>
            {LANGS.filter((l) => versions[l]).map((l) =>
              l === lang ? (
                <span class="seg__on" aria-current="true">{l.toUpperCase()}</span>
              ) : (
                <a href={versions[l]} hreflang={l} lang={l}>
                  {l.toUpperCase()}<span class="sr-only"> — {versionLabel[l]}</span>
                </a>
              ),
            )}
          </div>
        )}
        <div class="seg" role="group" aria-label={t.theme} data-theme-switch>
          <button type="button" data-choice="auto" aria-pressed="true">AUTO</button>
          <button type="button" data-choice="light" aria-pressed="false">PAPER</button>
          <button type="button" data-choice="dark" aria-pressed="false">BLUEPRINT</button>
        </div>
      </div>
      <div class="foot-sheet meta">
        <span>© {year} yunoxia</span>
        <span>REV <time datetime={rev.replaceAll('.', '-')}>{rev}</time></span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const group = document.querySelector('[data-theme-switch]');
        if (!group) return;
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: dark)');
        let choice = 'auto';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') choice = stored;
        } catch {}
        const apply = () => {
          root.dataset.theme = choice === 'auto' ? (system.matches ? 'dark' : 'light') : choice;
          for (const b of group.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b.dataset.choice === choice));
        };
        apply();
        // AUTO follows the system while the page is open
        system.addEventListener('change', () => choice === 'auto' && apply());
        group.addEventListener('click', (e) => {
          const b = e.target.closest('button[data-choice]');
          if (!b) return;
          choice = b.dataset.choice;
          try {
            if (choice === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', choice);
          } catch {}
          apply();
        });
      })();
    </script>
    <script is:inline>
      // Contents of a post: the section last scrolled past is the current one (ink, heavy rule)
      (() => {
        const links = [...document.querySelectorAll('[data-toc] a[href^="#"]')];
        if (links.length < 2 || !('IntersectionObserver' in window)) return;
        const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
        const heads = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean);
        const mark = () => {
          let current = heads[0];
          for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) current = h;
          for (const a of links) {
            if (byId.get(current.id) === a) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          }
        };
        const io = new IntersectionObserver(mark, { rootMargin: '0px 0px -70% 0px' });
        for (const h of heads) io.observe(h);
        mark();
      })();
    </script>
    <script>
      import '../motion/reveal';
    </script>
    <Bead />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    z-index: 10;
  }

  .skip:focus {
    top: 0.5rem;
  }

  /* 52px bar with one hairline; the current page is underlined at the bar's lower edge */
  .site-header {
    display: flex;
    align-items: stretch;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--bar-height);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  /* Wordmark: Geist 800, cut into layer lines like a sliced part */
  .brand {
    align-self: center;
    margin-right: auto;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    text-decoration: none;
    -webkit-mask-image: repeating-linear-gradient(to bottom, #000 0 0.1034em, transparent 0.1034em 0.1422em);
    mask-image: repeating-linear-gradient(to bottom, #000 0 0.1034em, transparent 0.1034em 0.1422em);
  }

  .brand:hover {
    color: var(--ink);
  }

  .site-header nav {
    display: flex;
  }

  .site-header nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header nav li {
    display: flex;
  }

  .site-header nav a {
    display: flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem;
    letter-spacing: -0.03em;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    margin-bottom: -1px;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-header nav a[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  .lang {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    min-width: 2.75rem;
    text-align: center;
  }

  .lang:hover {
    color: var(--ink);
  }

  main {
    min-height: 70vh;
  }

  /* Footer: four columns over a hairline, the sheet's bottom row under another */
  .site-footer {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin: var(--section-y) var(--gutter) 0;
    padding: var(--space-8) 0 var(--space-6);
    border-top: 1px solid var(--line);
  }

  .foot-mark .brand {
    display: inline-block;
  }

  .foot-line {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .foot-nav,
  .foot-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  /* Each link is at least 24px tall (WCAG 2.5.8) */
  .foot-nav a,
  .foot-links a {
    padding-block: 4px;
    line-height: 1.5;
    color: var(--ink);
    text-decoration: none;
  }

  .foot-nav a {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: -0.03em;
  }

  .foot-links a {
    font-size: 0.875rem;
  }

  .foot-nav a:hover,
  .foot-links a:hover {
    color: var(--pen);
  }

  .foot-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }

  /* Language and theme: framed mono labels, the chosen one filled with ink */
  .seg {
    display: inline-flex;
    border: 1px solid var(--muted);
  }

  .seg > * {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-standard),
      background var(--dur-base) var(--ease-standard);
  }

  .seg > * + * {
    border-left: 1px solid var(--muted);
  }

  .seg > :hover {
    color: var(--pen);
  }

  .seg > .seg__on,
  .seg > [aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    cursor: default;
  }

  .seg > :active {
    transition: none;
  }

  .foot-sheet {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 48rem) {
    .site-footer {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .foot-mark {
      grid-column: 1 / -1;
    }

    .foot-controls {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }
  }

  /* Phones: the nav drops to its own row under the wordmark, keeping the bottom-edge underline */
  @media (max-width: 34rem) {
    .site-header {
      flex-wrap: wrap;
      column-gap: 1rem;
    }

    .brand {
      padding-block: 0.9rem;
    }

    .site-header nav {
      order: 3;
      width: 100%;
      height: 2.75rem;
    }

    .site-header nav ul {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
