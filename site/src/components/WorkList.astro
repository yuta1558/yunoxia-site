---
import type { CollectionEntry } from 'astro:content';

interface Props {
  works: CollectionEntry<'works'>[];
}

const { works } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<ul class="works">
  {works.map((w) => (
    <li>
      <a href={`/works/${w.id}/`}>
        <span class="title">{w.data.title}</span>
        <span class="summary">{w.data.summary}</span>
        <span class="meta">
          {w.data.status} · <time datetime={w.data.updated.toISOString()}>{fmt(w.data.updated)}</time> 更新
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr auto;
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding-block: 1.25rem;
    text-decoration: none;
    transition: padding-left 0.35s var(--ease-out);
  }

  a:hover {
    padding-left: 0.5rem;
  }

  .title {
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .summary {
    color: var(--muted);
  }

  @media (max-width: 48rem) {
    a {
      grid-template-columns: 1fr;
    }
  }
</style>
