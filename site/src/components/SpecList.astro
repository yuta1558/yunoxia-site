---
// SpecList (design system v4): a heavy ink rule on top, a mono label, a light large numeral with a
// small mono unit, and one line of explanation. Four columns, two on phones. Used on the top page
// and on Works pages whose front matter has `specs`.
interface Item {
  /** label (mono, upper case) */
  l: string;
  /** value, as written (keeps commas and signs such as ≤) */
  v: string;
  /** unit, set beside the value */
  u?: string;
  /** one line */
  t?: string;
}

const { items } = Astro.props as { items: Item[] };
---

<dl class="specs">
  {items.map((s) => (
    <div class="rule-draw">
      <dt class="meta">{s.l}</dt>
      <dd>
        <span class:list={['num', { 'num--long': s.v.length > 6 }]}>{s.v}</span>
        {s.u && <span class="unit">{s.u}</span>}
      </dd>
      {s.t && <dd class="desc">{s.t}</dd>}
    </div>
  ))}
</dl>

<style>
  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0;
  }

  /* The heavy rule on top is .rule-draw (global.css), so it can be drawn */
  .specs > div {
    padding-top: 1rem;
  }

  .specs dd {
    margin: 0;
  }

  .specs dd:not(.desc) {
    margin: 1.5rem 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .num {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  /* A from → to pair: smaller so it stays on one line in a half-width column at 390px */
  .num--long {
    font-size: clamp(1.45rem, 2.6vw, 2.4rem);
    white-space: nowrap;
  }

  .unit {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .specs .desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 48rem) {
    .specs {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
  }
</style>
