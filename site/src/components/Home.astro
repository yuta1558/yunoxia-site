---
// The top page, shared by / and /en/. Bands stacked full width:
// hero panel → Works cards → Research band (dark) → numbers → Log.
import { getCollection } from 'astro:content';
import TopScene from '../scene/TopScene.astro';
import WorkCards from './WorkCards.astro';
import { contour } from './toolpath';
import { type Lang, localPath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const works = (await getCollection(lang === 'en' ? 'worksEn' : 'works'))
  .sort((a, b) => +b.data.updated - +a.data.updated)
  .slice(0, 3);
const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

// Every number here comes from the Research page; nothing is decorative
const t = {
  ja: {
    h1: ['分解して、', '理解して、', '作り替える。'],
    heroCta: '作ったものを見る',
    steps: ['01 分解 — 造形物を層のかたまりに分ける', '02 理解 — 一層ずつ測り、形を数値にする', '03 作り替え — 測った形を描き直し、刷り直す'],
    sheet: 'Sheet 01 / 04 — yunoxia、ゆーの制作と研究',
    worksTitle: ['作ったもの。', '直したもの。'],
    worksText: '既製品や仕組みを開けて中を見て、物理量に分けて理解し、他の人も使える道具にする。その記録。',
    worksCta: 'Works 一覧',
    statement: ['7,000 件を超える', '公開プロファイルを読んだ。', '同じフィラメントでも、', '最大体積流量は', '2.5 倍までずれる。'],
    researchText: 'スライサーの方言のあいだで、フィラメントの設定を物理量を介して変換する研究。',
    researchCta: '研究を読む',
    numbersTitle: '数字で見る。',
    numbersText: '分かったことは、単位の付いた数字で残す。',
    specs: [
      { v: '7,000', u: '+', l: 'Profiles', t: '分析した公開プロファイル。4 系統、2026 年 7 月時点。' },
      { v: '2.5', u: '×', l: 'Spread', t: '同じフィラメントの最大体積流量が、4 系統でずれる最大の幅。' },
      { v: '220', u: '°C', l: 'Nozzle', t: '温度は方言をまたいで一致する。Prusa 34 件中 20 件、Bambu 21 件中 20 件。' },
      { v: '84.9 → 57.7', u: '分', l: 'Print time', t: '変換したプロファイルでの造形時間。差の 8 割超は冷却の閾値から。' },
    ],
    logTitle: '記録。',
    logText: '作っているものの途中経過と、考えたこと。',
    logCta: 'Log 一覧',
  },
  en: {
    h1: ['Take it apart.', 'Understand it.', 'Remake it.'],
    heroCta: 'See the work',
    steps: ['01 Take apart — split the part into blocks of layers', '02 Understand — measure each layer, turn the shape into numbers', '03 Remake — redraw the profile and print it again'],
    sheet: 'Sheet 01 / 04 — yunoxia, making and research by Yu',
    worksTitle: ['Things made.', 'Things fixed.'],
    worksText: 'Open up products and systems, break them down into physical quantities, and turn what I learn into tools others can use.',
    worksCta: 'All works',
    statement: ['I read more than ', '7,000 public profiles.', 'For the same filament,', 'max volumetric flow', 'differs by up to 2.5×.'],
    researchText: 'Converting filament profiles between slicer dialects through physical quantities.',
    researchCta: 'Read the research',
    numbersTitle: 'In numbers.',
    numbersText: 'What I learn is kept as numbers with units.',
    specs: [
      { v: '7,000', u: '+', l: 'Profiles', t: 'Public profiles analysed, from four sources, as of July 2026.' },
      { v: '2.5', u: '×', l: 'Spread', t: 'Largest gap in max volumetric flow for the same filament across the four sources.' },
      { v: '220', u: '°C', l: 'Nozzle', t: 'Temperature agrees across dialects: 20 of 34 Prusa profiles, 20 of 21 Bambu.' },
      { v: '84.9 → 57.7', u: 'min', l: 'Print time', t: 'Print time with the converted profile; over 80% of the gap is the cooling threshold.' },
    ],
    logTitle: 'Log.',
    logText: 'Notes on work in progress, in Japanese.',
    logCta: 'All entries',
  },
}[lang];

const xray = Array.from({ length: 30 }, (_, i) => i);
---

<section class="hero" data-scene-host>
  <div class="hero__art">
    <TopScene steps={t.steps} />
  </div>
  <div class="hero__copy">
    <h1>
      {t.h1.map((line, i) => (
        <>
          {/* English lines need a word space in the text; the spans are blocks, so it does not render */}
          {i > 0 && lang === 'en' && ' '}
          {i === t.h1.length - 1 ? <span class="pen">{line}</span> : <span>{line}</span>}
        </>
      ))}
    </h1>
    <a class="btn btn--light" href={localPath(lang, '/works/')}>{t.heroCta}</a>
  </div>
  <p class="hero__sheet meta">{t.sheet}</p>
</section>

<section class="band-section">
  <div class="section-head">
    <h2>{t.worksTitle[0]}{lang === 'en' && ' '}<br />{t.worksTitle[1]}</h2>
    <p>{t.worksText}</p>
    <a class="btn btn--dark" href={localPath(lang, '/works/')}>{t.worksCta}</a>
  </div>
  <WorkCards works={works} lang={lang} />
</section>

<section class="dark band-edge">
  <p class="statement phrases">{t.statement.map((s) => <span>{s}</span>)}</p>
  <svg class="xray" viewBox="0 0 600 260" aria-hidden="true" focusable="false">
    {xray.map((i) => <path d={contour(i, 300, 240, 7, 230 - i * 3)} style={`opacity:${(0.12 + (i / 30) * 0.6).toFixed(3)}`} />)}
    {xray.map((i) => <path class="b" d={contour(i, 300, 240, 7, 120 + i * 2)} style={`opacity:${(0.08 + (i / 30) * 0.4).toFixed(3)}`} />)}
  </svg>
  <div class="section-head">
    <h2>Research.</h2>
    <p>{t.researchText}</p>
    <a class="btn btn--outline" href={localPath(lang, '/research/')}>{t.researchCta}</a>
  </div>
</section>

<section class="band-section">
  <div class="section-head">
    <h2>{t.numbersTitle}</h2>
    <p>{t.numbersText}</p>
    <span></span>
  </div>
  <dl class="specs">
    {t.specs.map((s) => (
      <div>
        <dt class="meta">{s.l}</dt>
        <dd>
          <span class:list={['num', { 'num--long': s.v.length > 6 }]}>{s.v}</span>
          {s.u && <span class="unit">{s.u}</span>}
        </dd>
        <dd class="desc">{s.t}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="band-section">
  <div class="section-head">
    <h2>{t.logTitle}</h2>
    <p>{t.logText}</p>
    <a class="btn btn--dark" href="/log/" hreflang={lang === 'en' ? 'ja' : undefined}>{t.logCta}</a>
  </div>
  <ul class="logs">
    {logs.map((l) => (
      <li>
        <a href={`/log/${l.id}/`} hreflang={lang === 'en' ? 'ja' : undefined}>
          <time class="meta" datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time>
          <span lang="ja">{l.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Hero: a full-width panel; the toolpath stands in for a product shot */
  .hero {
    position: relative;
    margin: var(--gutter);
    min-height: min(78vh, 46rem);
    background: var(--panel);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    overflow: clip;
  }

  .hero__art {
    padding: 2rem;
  }

  .hero__copy {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding: 2rem var(--gutter) 3rem 0;
  }

  /* The page's one heavy statement; every other heading stays light */
  h1 {
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    transition: color 0.4s var(--ease);
  }

  .pen {
    color: var(--pen);
  }

  /* While the scene runs, the line for its current step is the pen-blue one */
  .hero[data-phase] h1 span {
    color: var(--ink);
  }

  .hero[data-phase='1'] h1 span:nth-child(1),
  .hero[data-phase='2'] h1 span:nth-child(2),
  .hero[data-phase='3'] h1 span:nth-child(3) {
    color: var(--pen);
  }

  .hero__sheet {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
  }

  .band-section {
    padding: var(--section-y) var(--gutter) 0;
  }

  /* Research band: blueprint ground, x-ray linework */
  .dark {
    margin-top: var(--section-y);
    padding: var(--section-y) var(--gutter);
    background: var(--band);
    color: var(--band-ink);
  }

  .statement {
    max-width: 22em;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .xray {
    display: block;
    width: 100%;
    margin: clamp(2rem, 6vw, 4rem) 0;
  }

  .xray path {
    fill: none;
    stroke: var(--band-ink);
    stroke-width: 0.8;
  }

  .xray path.b {
    stroke: var(--band-pen);
  }

  .dark .section-head {
    margin-bottom: 0;
  }

  .dark .section-head p {
    color: var(--band-muted);
  }

  .dark :focus-visible {
    outline-color: var(--band-pen);
  }

  /* Numbers */
  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0;
  }

  .specs > div {
    border-top: 1.5px solid var(--ink);
    padding-top: 1rem;
  }

  .specs dd {
    margin: 0;
  }

  .specs dd:not(.desc) {
    margin: 1.5rem 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .num {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  /* A from → to pair: smaller so it stays on one line in a half-width column at 390px */
  .num--long {
    font-size: clamp(1.45rem, 2.6vw, 2.4rem);
    white-space: nowrap;
  }

  .unit {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .specs .desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Log */
  .logs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }

  .logs a {
    display: flex;
    gap: 2rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .logs span {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      align-content: end;
      min-height: 0;
    }

    .hero__art {
      padding: 1.5rem 1rem 0;
    }

    .hero__copy {
      padding: 0 1.25rem 3.5rem;
    }

    .specs {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }

    .logs a {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
