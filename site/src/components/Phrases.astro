---
// Phrase spans for .phrases (each an inline-block, so a line breaks only between phrases).
// English needs a real space between the spans; Japanese sets them flush.
import type { Lang } from '../i18n/ui';

interface Props {
  parts: readonly string[];
  lang: Lang;
}

const { parts, lang } = Astro.props;
const trimmed = parts.map((p) => p.trim());
---

{trimmed.map((p, i) => (
  <>
    {i > 0 && lang !== 'ja' && ' '}
    <span>{p}</span>
  </>
))}
