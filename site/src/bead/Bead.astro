---
// Molten bead + "updated since your last visit" marks.
// The marks work everywhere; the bead only runs with a fine pointer, motion allowed and a 2D canvas.
// Personality: ?bead=cute or ?bead=mystic (default mystic, remembered in localStorage "yx:bead").
---

<script>
  import { markUpdates } from './updates';

  const idle = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 200);

  idle(() => {
    markUpdates();
    const allowed =
      matchMedia('(pointer: fine)').matches &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !!document.createElement('canvas').getContext;
    if (allowed) import('./bead').then((m) => m.startBead());
  });
</script>

<style is:global>
  .yx-bead {
    position: fixed;
    left: 0;
    top: 0;
    width: 200px;
    height: 200px;
    pointer-events: none;
    z-index: 50;
    will-change: transform;
  }

  /* Fallback and companion to the bead: a small dot on links updated since the last visit.
     Links laid out as grid/flex can mark where the dot goes with a [data-badge] child. */
  a[data-updated='true']:not(:has([data-badge]))::after,
  a[data-updated='true'] [data-badge]::after {
    content: '';
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.4em;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.15em;
  }
</style>
