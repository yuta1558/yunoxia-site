---
// 実機検証（2026 年 9 月、PLA）の造形時間。数値は研究資料のとおりで、ここで新しく作った値はない。
const rows = [
  { label: '既存プロファイル', minutes: 84.9, kind: 'outlier' },
  { label: '変換したプロファイル', minutes: 57.7, kind: 'match' },
  { label: '変換なし（元の方言のまま）', minutes: 57.0, kind: 'match' },
] as const;

const scaleMax = 90;
const barX = 0;
const barW = 100; // percent of the bar track
const pct = (m: number) => (m / scaleMax) * barW;
---

<figure class="chart">
  <figcaption>
    造形時間。変換したプロファイルは、変換なしとほぼ同じ時間で終わり、既存プロファイルだけが長い。
  </figcaption>

  <ol class="bars" aria-hidden="true">
    {rows.map((r) => (
      <li class={r.kind}>
        <span class="label">{r.label}</span>
        <span class="track">
          <svg viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
            <rect x={barX} y="0" width={pct(r.minutes)} height="10" rx="0.6" />
          </svg>
        </span>
        <span class="value">{r.minutes.toFixed(1)} 分</span>
      </li>
    ))}
  </ol>

  <table class="sr-only">
    <caption>実機検証（2026 年 9 月、PLA）の造形時間</caption>
    <thead>
      <tr><th scope="col">プロファイル</th><th scope="col">造形時間</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr><th scope="row">{r.label}</th><td>{r.minutes.toFixed(1)} 分</td></tr>
      ))}
    </tbody>
  </table>
</figure>

<style>
  .chart {
    margin: 0;
    max-width: var(--measure);
  }

  figcaption {
    margin-bottom: 1.25rem;
  }

  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label value'
      'track track';
    gap: 0.3rem 1rem;
    align-items: baseline;
  }

  .label {
    grid-area: label;
    font-size: var(--step--1);
  }

  .value {
    grid-area: value;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .track {
    grid-area: track;
    display: block;
    height: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .track svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .match rect {
    fill: var(--accent);
  }

  .outlier rect {
    fill: var(--muted);
  }

  .outlier .value {
    color: var(--muted);
  }
</style>
