---
// 実機検証（2026 年 9 月、PLA）の造形時間。数値は研究資料のとおりで、ここで新しく作った値はない。
interface Props {
  lang?: 'ja' | 'en';
}
const { lang = 'ja' } = Astro.props;
const t = {
  ja: {
    labels: ['既存プロファイル', '変換したプロファイル', '変換なし（元の方言のまま）'],
    unit: '分',
    caption: '造形時間。変換したプロファイルは、変換なしとほぼ同じ時間で終わり、既存プロファイルだけが長い。',
    tableCaption: '実機検証（2026 年 9 月、PLA）の造形時間',
    colProfile: 'プロファイル',
    colTime: '造形時間',
  },
  en: {
    labels: ['Existing profile', 'Converted profile', 'Unconverted (source dialect as is)'],
    unit: 'min',
    caption: 'Print time. The converted profile finishes in about the same time as the unconverted one; only the existing profile takes longer.',
    tableCaption: 'Print time in the hardware test (September 2026, PLA)',
    colProfile: 'Profile',
    colTime: 'Print time',
  },
}[lang];
const rows = [
  { label: t.labels[0], minutes: 84.9, kind: 'outlier' },
  { label: t.labels[1], minutes: 57.7, kind: 'match' },
  { label: t.labels[2], minutes: 57.0, kind: 'match' },
] as const;

const scaleMax = 90;
const barX = 0;
const barW = 100; // percent of the bar track
const pct = (m: number) => (m / scaleMax) * barW;
---

<figure class="chart">
  <figcaption>{t.caption}</figcaption>

  <ol class="bars" aria-hidden="true">
    {rows.map((r) => (
      <li class={r.kind}>
        <span class="label">{r.label}</span>
        <span class="track">
          <svg viewBox="0 0 100 10" preserveAspectRatio="none" focusable="false">
            <rect x={barX} y="0" width={pct(r.minutes)} height="10" rx="0.6" />
          </svg>
        </span>
        <span class="value">{r.minutes.toFixed(1)} {t.unit}</span>
      </li>
    ))}
  </ol>

  <table class="sr-only">
    <caption>{t.tableCaption}</caption>
    <thead>
      <tr><th scope="col">{t.colProfile}</th><th scope="col">{t.colTime}</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr><th scope="row">{r.label}</th><td>{r.minutes.toFixed(1)} {t.unit}</td></tr>
      ))}
    </tbody>
  </table>
</figure>

<style>
  .chart {
    margin: 0;
    max-width: var(--measure);
  }

  figcaption {
    margin-bottom: 1.25rem;
  }

  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label value'
      'track track';
    gap: 0.3rem 1rem;
    align-items: baseline;
  }

  .label {
    grid-area: label;
    font-size: var(--step--1);
  }

  .value {
    grid-area: value;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .track {
    grid-area: track;
    display: block;
    height: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .track svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .match rect {
    fill: var(--accent);
  }

  .outlier rect {
    fill: var(--muted);
  }

  .outlier .value {
    color: var(--muted);
  }
</style>
