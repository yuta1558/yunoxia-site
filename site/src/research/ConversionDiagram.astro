---
// 2 段変換の構造図。スマホでも文字が潰れないよう、SVG ではなく HTML の段組みで描き、矢印だけ SVG にしている。
const quantities = ['体積流量', '熱履歴', 'ビード形状', '冷却速度'];
const classes = [
  { name: '材料固有', note: 'フィラメントが決める値' },
  { name: '機械固有', note: 'プリンターが決める値' },
  { name: '相互作用', note: '両方の組み合わせで決まる値（例：冷却ファン）' },
];
---

<figure class="diagram">
  <figcaption class="meta">変換の流れ</figcaption>

  <div class="flow">
    <div class="node">
      <p class="eyebrow">入力</p>
      <p class="title">元の方言</p>
      <p class="sub">Bambu Lab / Prusa / Polymaker / OrcaSlicer の公開プロファイル</p>
    </div>

    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 12h15M13 6l6 6-6 6" />
    </svg>

    <div class="node core">
      <p class="eyebrow">中間表現</p>
      <p class="title">物理量</p>
      <ul>
        {quantities.map((q) => <li>{q}</li>)}
      </ul>
    </div>

    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 12h15M13 6l6 6-6 6" />
    </svg>

    <div class="node">
      <p class="eyebrow">出力</p>
      <p class="title">目的の方言</p>
      <p class="sub">変換先の機種の設定</p>
    </div>
  </div>

  <dl class="classes">
    {classes.map((c) => (
      <div>
        <dt>{c.name}</dt>
        <dd>{c.note}</dd>
      </div>
    ))}
  </dl>
</figure>

<style>
  .diagram {
    margin: 0;
  }

  figcaption {
    margin-bottom: 1rem;
  }

  .flow {
    display: grid;
    grid-template-columns: 1fr auto 1.2fr auto 1fr;
    align-items: stretch;
    gap: 0.75rem;
  }

  .node {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
  }

  .node.core {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .node p {
    margin: 0;
  }

  .title {
    font-family: var(--font-jp);
    font-weight: 500;
    margin-block: 0.25rem 0.5rem !important;
  }

  .sub {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .node ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 0.75rem;
    font-size: var(--step--1);
  }

  .arrow {
    width: 1.5rem;
    align-self: center;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .classes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.25rem 0 0;
    font-size: var(--step--1);
  }

  .classes dt {
    font-weight: 500;
  }

  .classes dd {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  @media (max-width: 48rem) {
    .flow {
      grid-template-columns: 1fr;
    }

    .arrow {
      transform: rotate(90deg);
      justify-self: center;
    }

    .classes {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
