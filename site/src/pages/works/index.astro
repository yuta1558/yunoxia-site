---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCards from '../../components/WorkCards.astro';

const works = (await getCollection('works')).sort((a, b) => +b.data.updated - +a.data.updated);
---

<Base title="Works" description="分解して、理解して、作り替えたもの。進行中のものも含みます。">
  <section class="wrap page">
    <p class="eyebrow">Works</p>
    <h1 class="page-title phrases"><span>作ったもの。</span><span>作っているもの。</span></h1>
    <p class="intro">どれも「分解 → 理解 → 作り替え」の順に書いています。進行中のものは、その時点の状態です。</p>
    <WorkCards works={works} />
  </section>
</Base>
