---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import TopScene from '../../scene/TopScene.astro';

const works = (await getCollection('worksEn')).sort((a, b) => +b.data.updated - +a.data.updated);
const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

const acts = [
  { n: '01', verb: 'Take it apart', line: 'Products and systems alike: open them up and look inside first.' },
  { n: '02', verb: 'Understand it', line: 'Break what happens down into physical quantities like flow, temperature and cooling.' },
  { n: '03', verb: 'Remake it', line: 'Turn what I learn into tools other people can use.' },
];
---

<Base>
  <TopScene />
  <section class="hero wrap" data-scene="hero">
    <h1>Take it apart.<br />Understand it.<br />Remake it.</h1>
    <p class="lead">Where I dig deepest: industrial 3D printing.</p>
  </section>

  <section class="acts wrap" aria-label="How I work" data-scene="acts">
    {acts.map((a, i) => (
      <div class="act" data-act={i + 1}>
        <p class="eyebrow">{a.n}</p>
        <h2>{a.verb}</h2>
        <p>{a.line}</p>
      </div>
    ))}
  </section>

  <section class="wrap block" data-scene="after">
    <div class="block-head">
      <h2>Works</h2>
      <a class="meta" href="/en/works/">See all</a>
    </div>
    <WorkList works={works} lang="en" />
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Log <span class="meta">(in Japanese)</span></h2>
      <a class="meta" href="/log/" hreflang="ja">See all</a>
    </div>
    <ul class="logs">
      {logs.map((l) => (
        <li>
          <time class="meta" datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time>
          <a href={`/log/${l.id}/`} hreflang="ja" lang="ja">{l.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(3rem, 10vh, 6rem);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .lead {
    margin-top: 2rem;
    color: var(--muted);
  }

  .acts {
    display: grid;
    gap: 0;
    padding-block: 2rem 5rem;
  }

  /* Each act gets most of a screen so the scroll-driven scene has room to play out */
  .act {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 28rem;
  }

  .act h2 {
    font-size: var(--step-2);
    margin-block: 0.25rem 0.75rem;
  }

  .act p:last-child {
    color: var(--muted);
  }

  .block {
    padding-block: 2.5rem;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .block-head h2 {
    font-size: var(--step-1);
  }

  .logs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logs li {
    display: flex;
    gap: 1.5rem;
    padding-block: 0.6rem;
  }
</style>
