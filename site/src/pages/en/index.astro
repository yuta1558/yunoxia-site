---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import TopScene from '../../scene/TopScene.astro';

const works = (await getCollection('worksEn')).sort((a, b) => +b.data.updated - +a.data.updated);
const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

const acts = [
  { n: '01', verb: 'Take it apart', line: 'Products and systems alike: open them up and look inside first.' },
  { n: '02', verb: 'Understand it', line: 'Break what happens down into physical quantities like flow, temperature and cooling.' },
  { n: '03', verb: 'Remake it', line: 'Turn what I learn into tools other people can use.' },
];
---

<Base>
  <TopScene />
  <section class="hero wrap" data-scene="hero">
    <h1>Take it apart.<br />Understand it.<br />Remake it.</h1>
    <p class="lead">Where I dig deepest: industrial 3D printing.</p>
  </section>

  <section class="acts wrap" aria-label="How I work" data-scene="acts">
    {acts.map((a, i) => (
      <div class="act" data-act={i + 1}>
        <div class="act-text">
          <p class="eyebrow">{a.n}</p>
          <h2>{a.verb}</h2>
          <p>{a.line}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap block" data-scene="after">
    <div class="block-head">
      <h2>Works</h2>
      <a class="meta" href="/en/works/">See all</a>
    </div>
    <WorkList works={works} lang="en" />
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Log <span class="meta">(in Japanese)</span></h2>
      <a class="meta" href="/log/" hreflang="ja">See all</a>
    </div>
    <ul class="logs">
      {logs.map((l) => (
        <li>
          <time class="meta" datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time>
          <a href={`/log/${l.id}/`} hreflang="ja" lang="ja">{l.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(3rem, 10vh, 6rem);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .lead {
    margin-top: 2rem;
    color: var(--muted);
  }

  .acts {
    display: grid;
    gap: 0;
    padding-block: 2rem 5rem;
  }

  /* Each act gets most of a screen so the scroll-driven scene has room to play out */
  .act {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 28rem;
  }

  /* Phones with the live scene: the scene owns the lower half of the screen, and only the current
     act's text is shown, pinned above it, so text and scene never overlap. Without the scene the
     acts read as ordinary text. */
  @media (max-width: 48rem) {
    .act {
      max-width: none;
    }

    :global(html.scene-live) .act-text {
      position: fixed;
      top: 4.5rem;
      left: var(--gutter);
      right: var(--gutter);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s var(--ease-out), visibility 0.35s;
    }

    :global(html.scene-live) .acts[data-active='1'] .act[data-act='1'] .act-text,
    :global(html.scene-live) .acts[data-active='2'] .act[data-act='2'] .act-text,
    :global(html.scene-live) .acts[data-active='3'] .act[data-act='3'] .act-text {
      opacity: 1;
      visibility: visible;
    }
  }

  .act h2 {
    font-size: var(--step-2);
    margin-block: 0.25rem 0.75rem;
  }

  .act p:last-child {
    color: var(--muted);
  }

  .block {
    padding-block: 2.5rem;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .block-head h2 {
    font-size: var(--step-1);
  }

  .logs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logs li {
    display: flex;
    gap: 1.5rem;
    padding-block: 0.6rem;
  }
</style>
