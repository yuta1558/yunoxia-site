---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base title="Log" description="制作と研究の進み具合の記録。">
  <section class="wrap page">
    <p class="eyebrow">Log</p>
    <h1 class="page-title">進み具合の記録。</h1>
    <p class="intro">作っているものの途中経過と、考えたことを残します。<a href="/rss.xml">RSS</a> でも読めます。</p>
    <ol class="logs">
      {logs.map((l) => (
        <li>
          <a href={`/log/${l.id}/`}>
            <time class="meta" datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time>
            <span>{l.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  /* Same rows as the top page's Log. CMS posts are prepended with the same markup (functions/_lib/logs.js). */
  .logs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }

  .logs a {
    display: flex;
    gap: 2rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .logs span {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 48rem) {
    .logs a {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
