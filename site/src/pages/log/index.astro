---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base title="Log" description="制作と研究の進み具合の記録。">
  <section class="wrap page">
    <p class="eyebrow">Log</p>
    <h1>進み具合の記録</h1>
    <p class="intro">作っているものの途中経過と、考えたことを残します。<a href="/rss.xml">RSS</a> でも読めます。</p>
    <ol class="logs">
      {logs.map((l) => (
        <li>
          <time class="meta" datetime={l.data.date.toISOString()}>{fmt(l.data.date)}</time>
          <a href={`/log/${l.id}/`}>{l.data.title}</a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .page {
    padding-block: 3rem;
  }

  h1 {
    font-size: var(--step-2);
    margin-block: 0.5rem 1rem;
  }

  .intro {
    color: var(--muted);
    max-width: var(--measure);
    margin-bottom: 3rem;
  }

  .logs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .logs li {
    display: flex;
    gap: 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
</style>
