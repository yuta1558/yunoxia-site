---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { excerpt } from '../../lib/excerpt.mjs';

export async function getStaticPaths() {
  const logs = await getCollection('log');
  return logs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

// Description: the first paragraph as plain text (also used by the RSS feed)
const description = excerpt(entry.body) || undefined;
---

<Base title={entry.data.title} description={description} ogType="article">
  <article class="wrap page">
    <p class="eyebrow"><a href="/log/">Log</a></p>
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="meta">
      <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
      {entry.data.tags.length > 0 && <> · {entry.data.tags.join(' / ')}</>}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>

  .eyebrow a {
    text-decoration: none;
  }


  .prose {
    margin-top: 2rem;
  }
</style>
